      "id": "ROOT_BACKUP_MIRROR",
      "priority": 1000,
      "match": {"root": ["Backup mirror"]},
      "assign": {
        "department": "Evidence / Archive / Backup",
        "lifecycle": "Archived",
        "governance_gate": "Permission / Audit / Backup / Restore Validation",
        "phase": "Recovery Mirror",
        "priority": "P4",
        "update_policy": "read_only_mirror",
        "memory_type": "Backup mirror",
        "architecture_layer": "Recovery",
        "visualisation_type": "Backup / Integrity Map",
        "confidence": 1.0
      },
      "reason": "Backup root is recovery context only and can never be canonical."
    },
    {
      "id": "ROOT_KILO_AUDIT",
      "priority": 990,
      "match": {"root": ["Kilo audit workspace"]},
      "assign": {
        "department": "Evidence / Archive / Backup",
        "lifecycle": "Audit & Classification",
        "governance_gate": "Permission / Audit / Backup / Restore Validation",
        "phase": "Audit Evidence",
        "priority": "P4",
        "update_policy": "read_only_audit_evidence",
